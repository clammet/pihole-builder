{
  "target": "pi4",
  "hostname": "pihole",
  "timezone": "Australia/Melbourne",
  "admin_password": "replace-with-a-long-password",
  "ssh_authorized_keys": [],
  "network": {
    "interface": "eth0",
    "address": null,
    "gateway": null,
    "host_dns": ["1.1.1.1", "9.9.9.9"]
  },
  "pihole": {
    "image": "docker.io/pihole/pihole:latest",
    "upstream_dns": ["1.1.1.1", "9.9.9.9"],
    "web_port": 80
  },
  "updates": {
    "container_calendar": "*-*-* 03:00:00",
    "os_calendar": "*-*-* 04:00:00",
    "random_delay_seconds": 600,
    "health_timeout_seconds": 180,
    "health_successes": 3,
    "retry_failed_after_hours": 24
  },
  "image_size_mib": 12288
}
