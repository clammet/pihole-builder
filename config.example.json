{
  "target": "pi4",
  "hostname": "pihole",
  "timezone": "Australia/Melbourne",
  "admin_password": "replace-with-a-long-password",
  "ssh_authorized_keys": [],
  "network": {
    "interface": "eth0",
    "address": null,
    "gateway": null,
    "host_dns": ["1.1.1.1", "9.9.9.9"]
  },
  "pihole": {
    "image": "docker.io/pihole/pihole:latest",
    "upstream_dns": ["1.1.1.1", "9.9.9.9"],
    "web_port": 80,
    "dnssec": false,
    "domain_needed": false,
    "query_logging": true,
    "privacy_level": 0,
    "cache_optimizer": 3600,
    "database_days": 7,
    "ram_logs": false,
    "ram_data": false,
    "ram_size_mib": 384,
    "web_session_timeout": 1800,
    "web_headers": null,
    "adlists": null,
    "health_domain": "appliance-health.test",
    "local_records": []
  },
  "logging": {
    "storage": "auto",
    "max_level": "debug"
  },
  "updates": {
    "container_calendar": "*-*-* 03:00:00",
    "os_calendar": "*-*-* 04:00:00",
    "random_delay_seconds": 600,
    "health_timeout_seconds": 180,
    "health_successes": 3,
    "retry_failed_after_hours": 24
  },
  "image_size_mib": 12288
}
